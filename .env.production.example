NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://v79commerce:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/v79commerce?schema=public
REDIS_URL=redis://redis:6379

AUTH_MODE=hub
JWT_ISSUER=https://hub.v79sl.com
JWT_AUDIENCE=v79-commerce
HUB_JWKS_URL=https://hub.v79sl.com/.well-known/jwks.json
CORS_ORIGINS=https://commerce.v79sl.com

REPLENISHMENT_INTERVAL_MINUTES=60
LOG_LEVEL=info
TRUST_PROXY=true

GIFT_CARD_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

PROXY_NETWORK=proxy_network
BACKUP_RETENTION_DAYS=30
